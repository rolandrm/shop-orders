    "/": {
      "get": {
        "description": "Returns a fixed plain-text greeting. Demonstration route: it takes no parameter and reads no data.",
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The greeting, as plain text."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "Stable machine-readable error identifier in upper snake case, for example VALIDATION_ERROR or PRODUCT_NOT_FOUND. Branch on it rather than on message.",
                      "pattern": "^[A-Z][A-Z0-9_]*$",
                      "type": "string"
                    },
                    "details": {
                      "description": "One entry per invalid input. Empty when the error has no per-parameter detail.",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "message": {
                            "description": "What is wrong with this parameter.",
                            "type": "string"
                          },
                          "path": {
                            "description": "Name of the invalid parameter. Empty when the issue applies to the request as a whole, for example an unknown parameter.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "message": {
                      "description": "Human-readable explanation, in English. Its wording may change: do not parse it.",
                      "type": "string"
                    },
                    "statusCode": {
                      "description": "HTTP status code of the response, repeated in the body.",
                      "maximum": 599,
                      "minimum": 400,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "statusCode",
                    "code",
                    "message",
                    "details"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Unexpected error on the server side, not caused by the request."
          }
        },
        "summary": "Check that the service responds",
        "tags": [
          "App"
        ]
      }
    },
