    "/v1/products": {
      "get": {
        "description": "Returns one page of products, ordered by ascending id. Optionally keeps only the products priced in one currency. Pagination is cursor-based: pass the nextCursor of a response as cursor to get the next page.",
        "operationId": "CatalogController_listProducts_v1",
        "parameters": [
          {
            "description": "Maximum number of products in the page, from 1 to 100. Defaults to 20. A value outside this range is rejected with 400, never adjusted.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Pagination token: the nextCursor value of a previous response. Returns the products that follow the last product of that page. Omit it to get the first page. A value that is not a token issued by this API is rejected with 400.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            }
          },
          {
            "description": "Keeps only the products whose price is expressed in this currency: EUR, USD or GBP. The stored currency is matched as is, with no conversion; the value is case-sensitive. Omit it to get products in every currency.",
            "in": "query",
            "name": "currency",
            "required": false,
            "schema": {
              "enum": [
                "EUR",
                "USD",
                "GBP"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "description": "Products of the page, ordered by ascending id. At most 100 entries.",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "description": "Unique identifier of the product, a UUID.",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                            "type": "string"
                          },
                          "name": {
                            "description": "Display name of the product.",
                            "maxLength": 200,
                            "minLength": 1,
                            "type": "string"
                          },
                          "price": {
                            "additionalProperties": false,
                            "description": "Unit price of the product.",
                            "properties": {
                              "amount": {
                                "description": "Decimal amount as a string with exactly two decimals, for example \"19.90\". Never a JSON number.",
                                "pattern": "^\\d+\\.\\d{2}$",
                                "type": "string"
                              },
                              "currency": {
                                "description": "Currency of the amount: EUR, USD or GBP.",
                                "enum": [
                                  "EUR",
                                  "USD",
                                  "GBP"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "amount",
                              "currency"
                            ],
                            "type": "object"
                          },
                          "stock": {
                            "description": "Number of units available for sale at read time. 0 means out of stock. Never null.",
                            "maximum": 2147483647,
                            "minimum": 0,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "price",
                          "stock"
                        ],
                        "type": "object"
                      },
                      "maxItems": 100,
                      "type": "array"
                    },
                    "nextCursor": {
                      "description": "Token to pass as cursor to get the next page, or null when no product follows the last one of items.",
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "One page of products, possibly empty. nextCursor is null when no product follows the last one of items."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "Stable machine-readable error identifier in upper snake case, for example VALIDATION_ERROR or PRODUCT_NOT_FOUND. Branch on it rather than on message.",
                      "pattern": "^[A-Z][A-Z0-9_]*$",
                      "type": "string"
                    },
                    "details": {
                      "description": "One entry per invalid input. Empty when the error has no per-parameter detail.",
