{
  "project": {
    "name": "shop-orders",
    "description": "",
    "stacks": [
      {
        "id": "api",
        "root": ".",
        "commands": {
          "build": "./gradlew build -x test -x integrationTest",
          "test": "./gradlew test",
          "lint": "./gradlew spotlessCheck",
          "test:integration": "./gradlew integrationTest",
          "openapi": "./gradlew -q openapiExport"
        }
      }
    ]
  },
  "global": {},
  "paths": {
    "docs": [
      "docs/"
    ],
    "generated": [],
    "protected": [
      "docs/decisions/"
    ]
  },
  "publish": {
    "image": "ghcr.io/rolandrm/shop-orders",
    "extra": {
      "migrate": {
        "target": "migrate"
      }
    }
  },
  "backends": {
    "shop-api": {
      "contracts": "git@github.com:rolandrm/api-contracts.git"
    }
  }
}
